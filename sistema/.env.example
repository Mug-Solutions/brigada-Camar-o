# Copie este arquivo para .env.local e preencha com os dados do
# seu projeto Supabase (Project Settings > API).
#
# SUPABASE_SERVICE_ROLE_KEY é uma chave de servidor com acesso total
# ao banco — nunca deve ter o prefixo NEXT_PUBLIC_ e nunca deve ser
# exposta ao navegador. É usada apenas dentro de Server Components e
# Server Actions (veja src/lib/supabase/server.ts).

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_ANON_KEY habilitam a
# autenticação de usuários (login, Portal do Bombeiro). A anon key é
# segura para expor ao navegador — o acesso real é controlado pelas
# políticas de RLS no banco, não pelo sigilo desta chave.
# Sem essas duas variáveis, o proxy (src/proxy.ts) não exige login em
# nenhuma rota — mesmo comportamento de "modo apresentação" de hoje.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública onde este app está rodando — usada para montar o link de
# convite que vai por e-mail quando a coordenação aprova um bombeiro
# (src/app/(admin)/bombeiros/aprovacoes/actions.ts). Sem essa variável,
# cai em http://localhost:3000, o que só funciona em desenvolvimento
# local. Em produção, aponte para o domínio real do sistema.
SITE_URL=http://localhost:3000

# API key do Resend (resend.com/api-keys) — usada por src/lib/email
# pra mandar e-mail de negócio (ex.: alerta de documento vencendo),
# diferente do SMTP configurado no painel do Supabase (que só cobre
# e-mails de autenticação, tipo o convite). Sem essa variável, o job
# diário continua criando as notificações in-app normalmente, só o
# e-mail não sai (fica logado como erro no servidor).
RESEND_API_KEY=

# Remetente usado nesses e-mails de negócio (src/lib/email/enviar.ts).
# Sem essa variável, cai no domínio de sandbox do Resend
# (onboarding@resend.dev), que só entrega de forma confiável pro
# próprio dono da conta Resend — não serve pra produção. Antes de usar
# em produção, verifique um domínio próprio no Resend (resend.com/domains,
# precisa adicionar registros SPF/DKIM/DMARC no DNS do domínio público
# que vocês vão usar) e aponte pra um remetente desse domínio, ex.:
# EMAIL_FROM="Brigada Camarão <alertas@seudominio.com.br>"
EMAIL_FROM=

# Segredo que só o agendador externo (cron do provedor de hospedagem)
# deve conhecer, pra chamar POST /api/jobs/verificar-vencimentos como
# "Authorization: Bearer <CRON_SECRET>". Sem essa variável, a rota
# recusa toda chamada (falha fechada) — gere um valor aleatório longo,
# não reaproveite nenhuma outra chave.
CRON_SECRET=
